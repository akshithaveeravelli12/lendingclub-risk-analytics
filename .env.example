# Account identifier: Snowflake UI → bottom-left account menu → "Connect a tool" / account details
SNOWFLAKE_ACCOUNT=abc12345.us-west-2
SNOWFLAKE_USER=AKKI
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=LOAN_WH
SNOWFLAKE_DATABASE=LOAN_RISK

# Auth option A: password or a Programmatic Access Token (PAT) in place of the password
SNOWFLAKE_PASSWORD=

# Auth option B: key-pair (recommended if your account enforces MFA). Leave blank to use A.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

DATA_DIR=data
